# 복사해서 app/.env.local 로 만들고 값을 채운다. .env.local 은 Git에 올라가지 않는다
# Supabase 대시보드 > Project Settings > API (또는 Connect) 에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ── 서버 전용 (NEXT_PUBLIC_ 없음 = 브라우저로 안 나감). DB 비밀번호가 들어가므로 절대 공유 금지
# Supabase 대시보드 상단 Connect > Connection String 에서 복사하고 [YOUR-PASSWORD] 를 DB 비밀번호로 바꾼다
# 앱이 쓰는 주소: Transaction pooler (포트 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
# 마이그레이션(drizzle-kit)이 쓰는 주소: Session pooler (포트 5432)
MIGRATION_DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# ── 카카오 (지도 미리보기·연습실 검색, specs/instructor-studio). 카카오 디벨로퍼스 > 내 애플리케이션 > [앱] > [플랫폼 키]
# 카카오맵 사용 설정을 켜고, JavaScript 키의 [JavaScript SDK 도메인]에 http://localhost:3100 과 배포 주소를 등록한다
# JavaScript 키: 브라우저 지도 SDK용이라 공개된다(도메인 등록이 보호한다)
NEXT_PUBLIC_KAKAO_JS_KEY=
# REST API 키: 서버 전용 (연습실 이름·주소 검색). NEXT_PUBLIC_ 을 붙이지 않는다
KAKAO_REST_API_KEY=
